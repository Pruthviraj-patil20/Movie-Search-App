# CineSphere Environment Variables
# TMDB API configuration for movie data

VITE_TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/

# Note: Browser-exposed VITE_ variables are not secret.
# Production applications requiring secret credentials should use a backend proxy.